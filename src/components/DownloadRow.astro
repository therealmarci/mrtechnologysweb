---
// Eine Zeile der Download-Seite: Projekt links, rechts pro Variante (Plugin / Mod) die Version des gewählten Kanals.
// Alle Minecraft-Versionen und beide Kanäle werden fertig gerendert, die Seite blendet per data-mc / data-ch um.
import PixelIcon from './PixelIcon.astro';
import type { Lang, Project } from '../config';
import { t, dateFmt } from '../i18n';
import { getReleases, formatSize, pickChannels, versionParts, type Release } from '../lib/github';
import { href } from '../lib/url';

interface Props {
  lang: Lang;
  project: Project;
  /** alle Minecraft-Versionen der Seite, neueste zuerst */
  mcVersions: string[];
}
const { lang, project: p, mcVersions } = Astro.props;
const releases = await getReleases(p);
const multi = p.variants.length > 1;
const meta = (r: Release) => [dateFmt(lang, r.date), r.asset && formatSize(r.asset.size)].filter(Boolean).join(' · ');
const channelLabel = (r: Release) => t(lang, r.prerelease ? 'downloads.beta' : 'downloads.stable');
---

<article class="panel dl-row" id={p.slug}>
  <header class="dl-row-head">
    <div class="card-icon"><PixelIcon name={p.icon} /></div>
    <div>
      <h3><a href={href(lang, `wiki/${p.slug}`)}>{p.name}</a></h3>
      <span class="kind">{p.kind[lang]}</span>
    </div>
  </header>

  {
    mcVersions.map((mc, i) => {
      const lines = p.variants.map((v) => ({ v, ...pickChannels(releases, mc, v.id) }));
      const history = lines.flatMap((l) => l.all.map((r) => ({ v: l.v, r })));
      return (
        <div class="dl-row-body" data-mc={mc} hidden={i > 0}>
          {history.length === 0 ? (
            <p class="dl-none">
              {t(lang, 'release.notFor')} {mc}
            </p>
          ) : (
            <>
              {lines.map(({ v, stable, beta }) => (
                <div class="dl-var">
                  {multi && <span class="dl-variant">{v.label[lang]}</span>}
                  {!stable ? (
                    <p class="dl-none">
                      {t(lang, 'release.notFor')} {mc}
                    </p>
                  ) : (
                    (['stable', 'beta'] as const).map((ch) => {
                      const r = ch === 'stable' ? stable : beta!;
                      const parts = versionParts(r.version);
                      const onlyBeta = ch === 'stable' && r.prerelease;
                      const newerBeta = ch === 'stable' && !r.prerelease && beta && beta.prerelease ? beta : undefined;
                      return (
                        <div class="dl-pick" data-ch={ch}>
                          <div class="dl-pick-info">
                            <span class="dl-ver-line">
                              <span class={`dl-chip ${r.prerelease ? 'is-beta' : 'is-stable'}`}>{channelLabel(r)}</span>
                              <span class="dl-num">{parts.number}</span>
                              {parts.build !== undefined && (
                                <span class="dl-build">
                                  {t(lang, 'downloads.build')} {parts.build}
                                </span>
                              )}
                            </span>
                            <span class="dl-meta">{meta(r)}</span>
                            {onlyBeta && <span class="dl-note is-beta">{t(lang, 'downloads.onlyBeta')}</span>}
                            {ch === 'beta' && !r.prerelease && (
                              <span class="dl-note">{t(lang, 'downloads.stableIsNewest')}</span>
                            )}
                            {newerBeta && (
                              <button type="button" class="dl-switch" data-switch="beta">
                                {t(lang, 'downloads.newerBeta')}: {versionParts(newerBeta.version).number} →
                              </button>
                            )}
                          </div>
                          {r.asset && (
                            <a
                              class={`btn ${r.prerelease ? 'btn-gold' : 'btn-grass'}`}
                              href={r.asset.url}
                              title={r.asset.name}
                            >
                              ⬇ {t(lang, 'card.download')}
                            </a>
                          )}
                        </div>
                      );
                    })
                  )}
                </div>
              ))}

              <details class="dl-history">
                <summary>
                  {t(lang, 'downloads.history')} ({history.length})
                </summary>
                <ul>
                  {history.map(({ v, r }) => {
                    const parts = versionParts(r.version);
                    return (
                      <li>
                        <span class={`dl-chip small ${r.prerelease ? 'is-beta' : 'is-stable'}`}>{channelLabel(r)}</span>
                        <span class="dl-hist-ver">
                          {multi && <span class="dl-variant">{v.label[lang]}</span>}
                          {parts.number}
                          {parts.build !== undefined && <span class="dl-build"> · {t(lang, 'downloads.build')} {parts.build}</span>}
                        </span>
                        <span class="dl-meta">{dateFmt(lang, r.date)}</span>
                        <span class="dl-links">
                          <a href={r.url} target="_blank" rel="noopener">
                            {t(lang, 'release.changelog')}
                          </a>
                          {r.asset && <a href={r.asset.url}>⬇ .jar</a>}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </details>
            </>
          )}
        </div>
      );
    })
  }
</article>

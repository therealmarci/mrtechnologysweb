---
// Download-Kachel: MC-Version wählen, Download-Button pro Variante (Plugin / Mod),
// ältere Versionen derselben MC-Version eingeklappt darunter.
import PixelIcon from './PixelIcon.astro';
import type { Lang, Project } from '../config';
import { t, dateFmt } from '../i18n';
import { getReleases, formatSize, type Release } from '../lib/github';
import { href } from '../lib/url';

interface Props {
  lang: Lang;
  project: Project;
  /** ohne Kopf (Icon + Name), z.B. in der Seitenleiste der Anleitung */
  compact?: boolean;
}
const { lang, project: p, compact = false } = Astro.props;
const releases = await getReleases(p);
const mcVersions = [...new Set(releases.map((r) => r.mc))].sort((a, b) =>
  b.localeCompare(a, undefined, { numeric: true }),
);

// pro MC-Version und Variante: Hauptdownload (neueste stabile, sonst neueste Vorabversion),
// eine neuere Vorabversion als Hinweis und der Rest als ältere Versionen
const panels = mcVersions.map((mc) => ({
  mc,
  lines: p.variants.map((v) => {
    const list = releases.filter((r) => r.mc === mc && r.variant === v.id);
    const main = list.find((r) => !r.prerelease) ?? list[0];
    const newerPre = main && !main.prerelease ? list.find((r) => r.prerelease && r.date > main.date) : undefined;
    return { v, main, newerPre, older: list.filter((r) => r !== main && r !== newerPre) };
  }),
}));
const olderCount = (panel: (typeof panels)[number]) => panel.lines.reduce((n, l) => n + l.older.length, 0);
const multi = p.variants.length > 1;
const meta = (r: Release) => [dateFmt(lang, r.date), r.asset && formatSize(r.asset.size)].filter(Boolean).join(' · ');
const selectId = `mc-${p.slug}${compact ? '-c' : ''}`;
---

<article class:list={['panel dl-tile', { compact }]} id={compact ? undefined : p.slug} data-dl-tile>
  {
    !compact && (
      <div class="card-head">
        <div class="card-icon">
          <PixelIcon name={p.icon} />
        </div>
        <div>
          <h3>
            <a href={href(lang, `docs/${p.slug}`)}>{p.name}</a>
          </h3>
          <span class="kind">{p.kind[lang]}</span>
        </div>
      </div>
    )
  }
  {compact && <h2 class="dl-title">{t(lang, 'card.download')}</h2>}

  {
    mcVersions.length === 0 ? (
      <p class="muted">{t(lang, 'card.noRelease')}</p>
    ) : (
      <>
        <div class="dl-mc">
          <label for={selectId}>Minecraft</label>
          <select id={selectId} data-dl-select disabled={mcVersions.length < 2}>
            {mcVersions.map((mc) => (
              <option value={mc}>
                {mc}
                {!releases.some((r) => r.mc === mc && !r.prerelease) && ` (${t(lang, 'release.pre')})`}
              </option>
            ))}
          </select>
        </div>

        {panels.map((panel, i) => (
          <div data-mc-panel={panel.mc} hidden={i > 0}>
            {panel.lines.map(({ v, main, newerPre }) => (
              <div class="dl-line">
                <div class="dl-info">
                  {multi && <span class="dl-variant">{v.label[lang]}</span>}
                  {main ? (
                    <>
                      <span class="dl-ver">
                        v{main.version}
                        {main.prerelease && <span class="badge badge-pre">{t(lang, 'release.pre')}</span>}
                      </span>
                      <span class="dl-meta">{meta(main)}</span>
                      {newerPre?.asset && (
                        <a class="dl-pre" href={newerPre.asset.url}>
                          {t(lang, 'release.pre')} v{newerPre.version} ⬇
                        </a>
                      )}
                    </>
                  ) : (
                    <span class="dl-meta">
                      {t(lang, 'release.notFor')} {panel.mc}
                    </span>
                  )}
                </div>
                {main?.asset && (
                  <a
                    class={`btn ${main.prerelease ? 'btn-gold' : 'btn-grass'}`}
                    href={main.asset.url}
                    title={main.asset.name}
                  >
                    ⬇ {t(lang, 'card.download')}
                  </a>
                )}
              </div>
            ))}

            {olderCount(panel) > 0 && (
              <details class="dl-older">
                <summary>
                  {t(lang, 'release.older')} ({olderCount(panel)})
                </summary>
                {panel.lines
                  .filter((l) => l.older.length > 0)
                  .map((l) => (
                    <>
                      {multi && <span class="dl-variant">{l.v.label[lang]}</span>}
                      <ul>
                        {l.older.map((r) => (
                          <li>
                            <span class="dl-ver">v{r.version}</span>
                            {r.prerelease && <span class="badge badge-pre">{t(lang, 'release.preShort')}</span>}
                            <span class="dl-meta">{dateFmt(lang, r.date)}</span>
                            <span class="dl-links">
                              <a href={r.url} target="_blank" rel="noopener">
                                {t(lang, 'release.changelog')}
                              </a>
                              {r.asset && <a href={r.asset.url}>⬇ .jar</a>}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </>
                  ))}
              </details>
            )}
          </div>
        ))}
      </>
    )
  }
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-dl-tile]').forEach((tile) => {
    const select = tile.querySelector<HTMLSelectElement>('[data-dl-select]');
    select?.addEventListener('change', () => {
      tile.querySelectorAll<HTMLElement>('[data-mc-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.mcPanel !== select.value;
      });
    });
  });
</script>

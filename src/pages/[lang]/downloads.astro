---
// Download-Seite: oben der Installer (ganzer Server mit einem Befehl), darunter eine Leiste für Minecraft-Version und
// Kanal (Stable / Beta) und eine Zeile pro Projekt. Dev-Builds gibt es hier bewusst nicht (nur mit Freigabetoken).
import Base from '../../layouts/Base.astro';
import DownloadRow from '../../components/DownloadRow.astro';
import InstallTile from '../../components/InstallTile.astro';
import { PROJECTS, type Lang } from '../../config';
import { t } from '../../i18n';
import { langPaths } from '../../lib/paths';
import { getReleases } from '../../lib/github';
import { href } from '../../lib/url';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;

const all = (await Promise.all(PROJECTS.map((p) => getReleases(p)))).flat();
const mcVersions = [...new Set(all.map((r) => r.mc))].sort((a, b) => b.localeCompare(a, undefined, { numeric: true }));
const onlyBeta = (mc: string) => !all.some((r) => r.mc === mc && !r.prerelease);
---

<Base lang={lang} path="downloads" title={t(lang, 'nav.downloads')}>
  <div class="wrap">
    <div class="doc-head">
      <div>
        <h1>{t(lang, 'nav.downloads')}</h1>
        <p>{t(lang, 'downloads.intro')}</p>
      </div>
    </div>

    <InstallTile lang={lang} />

    <section class="dl-root" data-dl-root data-channel="stable" aria-labelledby="dl-plugins">
      <div class="dl-head">
        <h2 id="dl-plugins">{t(lang, 'downloads.single')}</h2>
        <p class="muted">{t(lang, 'downloads.singleLead')}</p>
      </div>

      <div class="panel dl-bar">
        <label class="dl-field">
          <span>Minecraft</span>
          <select data-dl-mc disabled={mcVersions.length < 2}>
            {mcVersions.map((mc) => (
              <option value={mc}>
                {mc}
                {onlyBeta(mc) && ` (${t(lang, 'downloads.beta')})`}
              </option>
            ))}
          </select>
        </label>
        <div class="dl-field">
          <span id="dl-channel-label">{t(lang, 'downloads.channel')}</span>
          <div class="dl-channels" role="radiogroup" aria-labelledby="dl-channel-label">
            <button type="button" role="radio" aria-checked="true" data-channel="stable">
              <strong>{t(lang, 'downloads.stable')}</strong>
              <small>{t(lang, 'downloads.stableHint')}</small>
            </button>
            <button type="button" role="radio" aria-checked="false" data-channel="beta">
              <strong>{t(lang, 'downloads.beta')}</strong>
              <small>{t(lang, 'downloads.betaHint')}</small>
            </button>
          </div>
        </div>
      </div>

      <div class="dl-betawarn" role="note">
        <strong>{t(lang, 'downloads.betaWarnTitle')}</strong>
        <span>{t(lang, 'downloads.betaWarn')}</span>
      </div>

      <div class="dl-list">
        {PROJECTS.map((p) => <DownloadRow lang={lang} project={p} mcVersions={mcVersions} />)}
      </div>

      <p class="dl-foot">
        {t(lang, 'downloads.mradminTip')}{' '}
        <a href={href(lang, 'wiki/mradmin/plugins')}>{t(lang, 'downloads.mradminTipLink')}</a>
      </p>
    </section>
  </div>
</Base>

<script>
  // Kanal und Minecraft-Version umschalten; die Wahl merkt sich der Browser (?channel=beta in der Adresse gewinnt).
  const root = document.querySelector<HTMLElement>('[data-dl-root]');
  if (root) {
    const store = {
      get: (k: string) => {
        try {
          return localStorage.getItem(k);
        } catch {
          return null;
        }
      },
      set: (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch {
          // ohne Speicher (privates Fenster): nur für diesen Besuch
        }
      },
    };
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-channel]')];
    const setChannel = (ch: string, remember = true) => {
      if (ch !== 'stable' && ch !== 'beta') return;
      root.dataset.channel = ch;
      buttons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.channel === ch)));
      if (remember) store.set('mrt-dl-channel', ch);
    };
    buttons.forEach((b) => b.addEventListener('click', () => setChannel(b.dataset.channel!)));
    root.querySelectorAll<HTMLButtonElement>('[data-switch]').forEach((b) =>
      b.addEventListener('click', () => {
        setChannel(b.dataset.switch!);
        b.closest('.dl-row')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }),
    );
    const fromUrl = new URLSearchParams(location.search).get('channel');
    setChannel(fromUrl ?? store.get('mrt-dl-channel') ?? 'stable', !!fromUrl);

    const select = root.querySelector<HTMLSelectElement>('[data-dl-mc]');
    const setMc = (mc: string) => {
      root.querySelectorAll<HTMLElement>('[data-mc]').forEach((el) => (el.hidden = el.dataset.mc !== mc));
    };
    select?.addEventListener('change', () => {
      setMc(select.value);
      store.set('mrt-dl-mc', select.value);
    });
    const savedMc = store.get('mrt-dl-mc');
    if (select && savedMc && [...select.options].some((o) => o.value === savedMc)) {
      select.value = savedMc;
      setMc(savedMc);
    }
  }
</script>

---
// Alte Anleitungs-Adressen /<lang>/docs/<projekt>/[<tab>]/ -> Wiki (gleiche Seite, falls es sie dort gibt).
import Redirect from '../../../../components/Redirect.astro';
import { LANGS, PROJECTS, type Lang } from '../../../../config';
import { href } from '../../../../lib/url';
import { getBook, pagePath, type WikiBook } from '../../../../lib/wiki';
import { renderPage } from '../../../../lib/wikiRender';
import { slug } from 'github-slugger';

export async function getStaticPaths() {
  const paths = [];
  for (const p of PROJECTS) {
    const book = await getBook(p, 'stable');
    if (!book) continue;
    const ids = new Set(['guide', ...p.docs.map((d) => d.id), ...book.pages.map((pg) => pg.id).filter(Boolean)]);
    for (const lang of LANGS) {
      for (const id of ids) paths.push({ params: { lang, slug: p.slug, page: id === 'guide' ? undefined : id }, props: { book, id } });
    }
  }
  return paths;
}

const { book, id } = Astro.props as { book: WikiBook; id: string };
const lang = Astro.params.lang as Lang;
const target = book.pages.find((pg) => pg.id === (id === 'guide' ? '' : id));
const to = href(lang, pagePath(book, target?.id ?? ''));
// Sprungmarken der alten README: Überschrift suchen, auf welcher Wiki-Seite sie jetzt steht
const anchors: Record<string, string> = {};
if (id === 'guide' && !book.legacy) {
  for (const pg of [...book.pages].reverse()) {
    const url = href(lang, pagePath(book, pg.id));
    for (const e of (await renderPage(book, pg, lang)).toc) anchors[e.id] = url;
    // frühere Kapitel sind jetzt ganze Seiten: #befehle -> Seite befehle bzw. Seite mit diesem Titel
    for (const key of [pg.id, slug(pg.title.de), slug(pg.title.en)]) if (key) anchors[key] = url;
  }
}
---

<Redirect to={to} anchors={anchors} />
